<Project>
    <ItemGroup>
        <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="All"/>
        <None Include="..\..\nuget.png" Pack="true" PackagePath="icon.png"/>
        <None Include="..\..\readme.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!-- The Shiny src libraries use a custom platform layout (Platforms/Apple|Android|Windows|Shared,
         Apple shared across ios+maccatalyst). MAUI apps (UseMaui=true) use the standard MAUI layout
         handled by the MAUI SDK, so skip this remapping for them or it strips their entry points (CS5001). -->
    <ItemGroup Condition="'$(UseMaui)' != 'true'">
        <None Include="Platforms\**\*.cs" />
        <Compile Remove="Platforms\**\*.cs" />
    </ItemGroup>

    <PropertyGroup Condition="'$(UseMaui)' != 'true' AND $(TargetFramework.Contains('-android'))">
        <DefineConstants>$(DefineConstants);PLATFORM;ANDROID</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(UseMaui)' != 'true' AND $(TargetFramework.Contains('-android'))">
        <Compile Include="Platforms\Android\**\*.cs" />
        <Compile Include="Platforms\Shared\**\*.cs" />
    </ItemGroup>


    <PropertyGroup Condition="'$(UseMaui)' != 'true' AND ($(TargetFramework.Contains('-ios')) OR $(TargetFramework.Contains('-maccatalyst')))">
        <DefineConstants>$(DefineConstants);PLATFORM;APPLE</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(UseMaui)' != 'true' AND ($(TargetFramework.Contains('-ios')) OR $(TargetFramework.Contains('-maccatalyst')))">
        <Compile Include="Platforms\Apple\**\*.cs" />
        <Compile Include="Platforms\Shared\**\*.cs" />
    </ItemGroup>


    <PropertyGroup Condition="'$(UseMaui)' != 'true' AND $(TargetFramework.Contains('-windows'))">
        <DefineConstants>$(DefineConstants);PLATFORM;WINDOWS</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(UseMaui)' != 'true' AND $(TargetFramework.Contains('-windows'))">
        <Compile Include="Platforms\Windows\**\*.cs" />
        <Compile Include="Platforms\Shared\**\*.cs" />
    </ItemGroup>
</Project>
