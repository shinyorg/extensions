<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <Description>Utilities for Microsoft.Extensions.DependencyInjection as well as source generation to remove some boilerplating</Description>
        <PackageTags>shiny dependencyinjection di dependency sourcegeneration</PackageTags>
        <RootNamespace>Shiny</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Extensions.DependencyInjection.SourceGenerators\Shiny.Extensions.DependencyInjection.SourceGenerators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Shiny.Extensions.Stores\Shiny.Extensions.Stores.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="build\Shiny.Extensions.DependencyInjection.props"
              PackagePath="build\Shiny.Extensions.DependencyInjection.props"
              Pack="true"/>

        <None Include="build\Shiny.Extensions.DependencyInjection.props"
              PackagePath="buildTransitive\Shiny.Extensions.DependencyInjection.props"
              Pack="true"/>
    </ItemGroup>

    <Target Name="_AddSourceGeneratorToPackage" BeforeTargets="_GetPackageFiles" DependsOnTargets="ResolveProjectReferences">
        <ItemGroup>
            <None Include="..\Shiny.Extensions.DependencyInjection.SourceGenerators\bin\$(Configuration)\netstandard2.0\Shiny.Extensions.DependencyInjection.SourceGenerators.dll"
                  Pack="true"
                  PackagePath="analyzers/dotnet/cs"
                  Visible="false"/>
        </ItemGroup>
    </Target>

</Project>