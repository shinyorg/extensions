<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework)</TargetFrameworks>
        <TargetFrameworks>$(TargetFrameworks);$(BaseTargetFramework)-android</TargetFrameworks>
        <TargetFrameworks Condition="'$(SupportsAppleTargets)' == 'true'">$(TargetFrameworks);$(BaseTargetFramework)-ios;$(BaseTargetFramework)-maccatalyst;$(BaseTargetFramework)-macos</TargetFrameworks>
        <TargetFrameworks Condition="'$(SupportsWindowsTargets)' == 'true'">$(TargetFrameworks);$(BaseTargetFramework)-windows10.0.19041.0</TargetFrameworks>

        <RootNamespace>Shiny</RootNamespace>
    </PropertyGroup>

    <!-- The macOS (AppKit) head is the dotnet/maui-labs backend, not Mac Catalyst. Microsoft.Maui.Essentials
         resolves its platform-neutral net10.0 asset there (every member throws NotImplementedInReferenceAssembly),
         so IAppSupport and IAppStore only work once the AppKit Essentials implementations are swapped in.
         AddAppSupport/AddAppStore call AddMacOSEssentials for you - hence the hard reference here. -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-macos'))">
        <!-- Don't force the SDK default (macOS 26) onto consumers - the AppKit backend targets 14.0. -->
        <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup Condition="$(TargetFramework.Contains('-macos'))">
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Core"/>
    </ItemGroup>

    <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
        <PackageReference Include="Xamarin.Google.Android.Play.Review"/>
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Shiny.Extensions.DependencyInjection\Shiny.Extensions.DependencyInjection.csproj" />
    </ItemGroup>
</Project>
